<%- include('partials/header') %>
    <main>
        <h1>Projects</h1>
        <p>Here are our upcoming service projects:</p>
        <ul>
            <% projects.forEach(project=> { %>
                <li>
                    <%= new Date(project.date).toLocaleDateString('en-US', { timeZone: 'UTC' }) %>:
                        <strong>
                            <%= project.title %>
                        </strong>
                        (<%= project.organization_name %>)
                </li>
                <% }); %>
        </ul>
    </main>
    <%- include('partials/footer') %>